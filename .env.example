# Neon pooled URL (for the Next.js app) — include pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=30"

# Neon direct URL (no -pooler) — used by prisma migrate / db push / seed
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"

# JWT secret for admin sessions (change in production)
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Contact form notifications go here
CONTACT_TO_EMAIL=you@gmail.com

# Gmail SMTP (App Password) — used for contact notify + admin replies
# Prefer 465/SSL; many networks block outbound 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=you@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM_EMAIL=you@gmail.com
SMTP_FROM_NAME=Muhammad Shoaib

# Analytics: comma-separated IPs to never count (set from Admin → Settings too)
# ANALYTICS_EXCLUDE_IPS=
# Localhost visits are tracked as country "Local". Exclude your browser/IP in Settings
# when you don't want your own testing mixed into production stats.
